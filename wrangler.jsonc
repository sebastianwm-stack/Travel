// Cloudflare Worker "reisebande": liefert die App aus public/ aus, /api/* beantwortet server/worker.js.
// Aufbau wie Maré (period) und Tropfen (mobile-game), zusätzlich mit D1-Datenbank, KV für Dateien und Workers AI.
{
  "name": "reisebande",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Gemeinsame Reisedaten. Ohne database_id legt Cloudflare die Datenbank beim ersten Deploy selbst an.
  "d1_databases": [
    { "binding": "DB", "database_name": "reisebande" }
  ],
  // Hochgeladene Fotos, PDFs und Tickets (bis 20 MB pro Datei)
  "kv_namespaces": [
    { "binding": "FILES" }
  ],
  // Reisebegleiter (kostenloses Tageskontingent)
  "ai": { "binding": "AI" },
  // Öffentlicher Schlüssel für Web Push. Der private liegt als Secret VAPID_PRIVATE_JWK bei Cloudflare.
  "vars": {
    "VAPID_PUBLIC": "BKvPbLCZaHrEWYVXaP_fzdMhjHHE4vrEz4saJGVbJXCDZtJen0dd3tp9NY4fnsXtKv8FqrC8K7TwzIa3ysQrnzc",
    "VAPID_SUBJECT": "mailto:reisebande@example.invalid"
  },
  // Jede Stunde prüfen, ob das Abendbriefing fällig ist
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
}
