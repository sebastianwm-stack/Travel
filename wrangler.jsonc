// Cloudflare Worker "reisebande": /api/* beantwortet server/worker.js, die App aus public/ steckt im Worker selbst
// (server/static-files.js, erzeugt von npm run build). Dazu D1-Datenbank, KV für Dateien und Workers AI.
// Deploy: npm run deploy
{
  "name": "reisebande",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-16",
  // Gemeinsame Reisedaten
  "d1_databases": [
    { "binding": "DB", "database_name": "reisebande", "database_id": "ff3b95c4-3222-4f76-8e3e-73b819d004ea" }
  ],
  // Hochgeladene Fotos, PDFs und Tickets (bis 20 MB pro Datei)
  "kv_namespaces": [
    { "binding": "FILES", "id": "4270aa0cbba747999aee628b402b5c9e" }
  ],
  // Reiseberater (kostenloses Tageskontingent)
  "ai": { "binding": "AI" },
  // Öffentlicher Schlüssel für Web Push. Der private liegt als Secret VAPID_PRIVATE_JWK bei Cloudflare.
  "vars": {
    "VAPID_PUBLIC": "BKvPbLCZaHrEWYVXaP_fzdMhjHHE4vrEz4saJGVbJXCDZtJen0dd3tp9NY4fnsXtKv8FqrC8K7TwzIa3ysQrnzc",
    "VAPID_SUBJECT": "https://reisebande.pages.dev"
  },
  // Jede Stunde prüfen, ob das Abendbriefing fällig ist
  "triggers": { "crons": ["7 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
